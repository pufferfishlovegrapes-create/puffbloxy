{
	"name": "scramjet-demo",
	"version": "2.0.0",
	"description": "The demo application for Scramjet, a high-performance web proxy.",
	"type": "module",
	"engines": {
		"npm": ">=7.0.0",
		"node": ">=16.0.0"
	},
	"scripts": {
		"build": "node --check src/index.js && node scripts/build-static.mjs",
		"start": "node src/index.js",
		"test": "node --test",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"keywords": [
		"proxy"
	],
	"author": "Mercury Workshop",
	"license": "GNU AFFERO",
	"dependencies": {
		"@fastify/static": "^9.0.0",
		"@mercuryworkshop/epoxy-transport": "3.0.1",
		"@mercuryworkshop/proxy-transports": "1.0.2",
		"@mercuryworkshop/scramjet": "2.0.67-alpha.2",
		"@mercuryworkshop/scramjet-controller": "0.0.14",
		"@vercel/analytics": "^2.0.1",
		"fastify": "^5.7.4",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"eslint": "^9.13.0",
		"prettier": "^3.3.3"
	},
	"packageManager": "pnpm@10.18.3"
}
